APP_NAME="Lamma"
APP_ENV=local
APP_KEY=
# MANDATORY in production: APP_DEBUG=false. Never deploy with APP_DEBUG=true.
APP_DEBUG=true
APP_URL=https://lamaa.alwafaamed.com

# Customer app update gate — leave APP_LATEST_VERSION empty.
# Latest is resolved automatically from apk/pubspec.yaml and/or client reports.
# Optional: php artisan app:sync-release-version after a Flutter version bump.
APP_LATEST_VERSION=
APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.alwafaa.lamma_app
APP_IOS_STORE_URL=
# APP_PUBSPEC_PATH=

# Restricted browser key for the Admin customer-address map only.
GOOGLE_MAPS_WEB_API_KEY=
# Unused for customer addresses (any map pin is accepted).
# SANAA_DELIVERY_POLYGON=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Aden

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Enable Laratrust permission cache (strongly recommended locally — admin sidebar checks 100+ permissions per page).
LARATRUST_ENABLE_CACHE=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alwafaam_lamma
DB_USERNAME=alwafaam_lamma
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# MANDATORY in production (HTTPS is required there): SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=null

# Admin session hardening
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=30
ADMIN_SESSION_ABSOLUTE_LIFETIME_MINUTES=480
ADMIN_SESSION_REMEMBER_ME_ENABLED=false
ADMIN_SESSION_PASSWORD_CONFIRMATION_MINUTES=15
AUTH_PASSWORD_TIMEOUT=900

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
# Named queues on Redis:
# - notifications  → SendPushNotificationJob (FCM)
# - search         → SyncProductToSearchJob / GenerateImageEmbeddingJob (+ remove siblings)
# Worker: php artisan queue:work redis --queue=notifications,search --tries=3
# Set to the real admin/production origin(s) before deploying; never use a wildcard with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Cloud Messaging uses a server-private service-account JSON file.
# Keep the file outside public_html, storage/app/public, source control, and all views.
# google-services.json (bundled into the Flutter app) is NOT this file — it only
# lets the app register for a device token. Sending FROM the Admin panel requires
# a separate Firebase Admin SDK service-account key, generated from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# Once obtained, place it under storage/app/private/ (outside the public web root)
# and set a project-relative path (works on Windows and cPanel), then set FCM_ENABLED=true.
FCM_ENABLED=false
FCM_PROJECT_ID=lamma-b4be1
FCM_CREDENTIALS_PATH=storage/app/private/lamma-firebase-adminsdk.json
FCM_GENERAL_TOPIC=lamma_general
FCM_CONNECT_TIMEOUT=5
FCM_REQUEST_TIMEOUT=15
FCM_RETRY_BACKOFF_SECONDS=60,300,900

# Optional Firebase Web client config for admin support-chat realtime (falls back to polling).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=lamma-b4be1.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=lamma-b4be1
FIREBASE_WEB_STORAGE_BUCKET=lamma-b4be1.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=968310231225
FIREBASE_WEB_APP_ID=

# Sanctum API token lifetime in minutes (default 43200 = 30 days). Tokens never expire if left empty.
SANCTUM_TOKEN_EXPIRATION=43200

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is required for the notifications + search queues (QUEUE_CONNECTION=redis).
# Needs the phpredis PHP extension (or set REDIS_CLIENT=predis after composer require predis/predis).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Search & Vector Configuration (Sprint 21.2)
SEARCH_TEXT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
MEILISEARCH_INDEX_PREFIX=lamma_catalog_
SEARCH_VECTOR_DRIVER=database_cosine
SEARCH_VECTOR_DIMENSION=512
SEARCH_VECTOR_MODEL=clip-vit-base-patch32
SEARCH_VECTOR_THRESHOLD=0.60
SEARCH_EMBEDDING_DRIVER=mock
CLIP_API_URL=
CLIP_API_KEY=
CLIP_API_TIMEOUT=120

# OTP & WhatsApp Configuration (Automexa WhAPI)
OTP_SENDER_DRIVER=whatsapp
WHAPI_URL=https://whapi.alwafaaye.com
WHAPI_API_KEY=

# Demo customer for app QA (phone + fixed OTP). Set false to disable.
OTP_DEMO_ENABLED=true
OTP_DEMO_PHONE=771771771
OTP_DEMO_CODE=123456
OTP_DEMO_NAME="مستخدم تجريبي"

# Payments (Jaib / Floosak). Use PAYMENTS_DRIVER=fake for local simulation (no live wallet calls).
PAYMENTS_DRIVER=fake
PAYMENTS_FAKE_PROVIDER_CODE=jaib
PAYMENTS_FAKE_FLOW_TYPE=step1
PAYMENTS_FAKE_OTP=123456
PAYMENTS_FAKE_FAIL_INITIATE=false
JAIB_BASE_URL=
JAIB_USERNAME=
JAIB_PASSWORD=
JAIB_AGENT_CODE=
JAIB_TIMEOUT=30
FLOOSAK_BASE_URL=https://staging.fintech-expert.net
FLOOSAK_API_KEY=
FLOOSAK_CHANNEL=merchant
FLOOSAK_SOURCE_WALLET_ID=
FLOOSAK_TIMEOUT=30
